{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "rootDir": "../..",
        "module": "commonjs",
        "types": ["node"],
        "declaration": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "target": "es2021",
        "moduleResolution": "bundler"
    },
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../../libs/shared/interfaces/tsconfig.lib.json"
        },
        {
            "path": "../../libs/backend/prisma/tsconfig.lib.json"
        }
    ]
}
